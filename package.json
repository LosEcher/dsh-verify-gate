{
  "name": "dsh-verify-gate",
  "version": "0.1.0",
  "description": "DSH 验证门禁工具：verify_run 调用 verify-gate 二进制（github.com/LosEcher/verify-gate），按声明式 TOML 清单（file/cmd/http/git/json 断言）机械执行验证并返回结构化报告——把「验证」从散文变成 exit 0/1/2 门禁。",
  "type": "module",
  "scripts": {
    "preflight": "node test/preflight.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "main": "index.mjs",
  "files": [
    "index.mjs",
    "lib",
    "cordis.patch.yml",
    "test",
    "README.md"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0"
  }
}
